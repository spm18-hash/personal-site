---
type Props = {
    title: string;
    href: string;
    date: Date;
    categories: string[];
    description: string;
};
import CategoryList from "./CategoryList.astro";
const { title, href, date, categories, description } = Astro.props;
---

<li>
    <h2 class="heading">
        <a href={href}>{title}</a>
    </h2>

    <p class="meta">
        Article posted on{" "}
        <time datetime={date.toISOString()}>
            {
                date.toLocaleDateString("en-IN", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                })
            }
        </time>
        <CategoryList categories={categories} />
    </p>
    <p class="description">{description}</p>
</li>

<style>
    ol {
        margin-block: 1em;
        max-width: 32em;
        padding-left: 0;
    }
    li > * {
        max-width: 32em;
    }
    .meta {
        margin-top: 0.8em;
        font-size: 0.9em;
    }

    .heading {
        max-width: 40em;
        letter-spacing: -0.02em;
        font-size: 1.75em;
        margin-top: 1.5em;
        text-wrap: balance;
        color: var(--brand-primary);
    }
    .heading:hover {
        color: var(--brand-primary-hover);
    }

    .description {
        font-size: 0.9em;
        text-wrap: pretty;
    }

    @media (min-width: 43em) {
        .heading {
            font-size: 2.45em;
            margin-top: 1.2em;
        }

        p {
            font-size: inherit;
        }
    }
</style>
