---
import Card from "./Card.astro";
import SectionHeader from "./SectionHeader.astro";

import type { Props as CardProps } from "./Card.astro";

const title = "Writing";
const description =
    '<p>I write a lot! You can dive straight to <a href="/blog">my blog here</a>, but here are a couple of hand-picked articles to get you started:</p>';

const writings: CardProps[] = [
    {
        href: "/blog/accessible-design",
        title: "Accessible Design",
        description:
            "Strategic support to shape the policies, programmes, and processes needed for long term, sustainable accessibility across your organisation.",
    },
    {
        href: "/blog/website-development",
        title: "Website Development",
        description:
            "Strategic support to shape the policies, programmes, and processes needed for long term, sustainable accessibility across your organisation.",
    },
    {
        href: "/services/accessibility-reviews",
        title: "Accessibility Reviews",
        description:
            "Strategic support to shape the policies, programmes, and processes needed for long term, sustainable accessibility across your organisation.",
    },
    {
        href: "/services/accessibility-audit",
        title: "Accessibility Audit",
        description:
            "Strategic support to shape the policies, programmes, and processes needed for long term, sustainable accessibility across your organisation.",
    },
];
---

<section>
    <SectionHeader title={title} description={description} />
    <ul class="help-card-container">
        {writings.map((writing, i) => <Card {...writing} />)}
    </ul>
</section>

<style>
    section {
        margin-top: calc(var(--spacing) * 12);
    }

    .help-card-container {
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        padding-left: 0;
    }

    @media (min-width: 43em) {
        section {
            margin-top: calc(var(--spacing) * 14);
        }
    }
</style>
