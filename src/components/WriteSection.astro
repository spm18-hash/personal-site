---
import SectionHeader from "./SectionHeader.astro";

import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";

const title = "Writing";
const description =
    '<p>I write a lot! You can dive straight to <a href="/blog/">my blog here</a>, but here are a couple of hand-picked articles to get you started:</p>';

const posts = await getCollection("blog", ({ data }) => {
    return data.draft === false && data.date > new Date("2026-01-01");
});
---

<section>
    <SectionHeader title={title} description={description} />
    <ul class="help-card-container">
        {posts.map(({ data }) => <BlogCard {...data} />)}
    </ul>
</section>

<style>
    section {
        margin-top: calc(var(--spacing) * 12);
    }

    .help-card-container {
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        padding-left: 0;
    }

    @media (min-width: 43em) {
        section {
            margin-top: calc(var(--spacing) * 14);
        }
    }
</style>
