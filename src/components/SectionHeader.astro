---
type Props = {
    title: string;
    description: string;
};
const { title, description } = Astro.props;
---

<h2>{title}</h2>
<Fragment set:html={description} />

<style>
    h2 {
        font-size: 1.55em;
    }

    p {
        max-width: 32em;
        color: var(--text-secondary);
    }

    @media (min-width: 43em) {
        h2 {
            font-size: 2.85em;
        }
    }
</style>
