---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
---

<BaseLayout>
    <h1>Blog</h1>
    <p>
        If you’re interested in accessibility, user experience design, and/or
        frontend development, you’re in the right place.
    </p>
    <ol>
        {
            posts.map(({ id, data }) => (
                <BlogCard {...data} href={`/blog/${id}`} />
            ))
        }
    </ol>
</BaseLayout>

<style>
    h1 {
        font-size: 2em;
    }
    code {
        background-color: white;
    }
    ol {
        margin-block: 1em;
        max-width: 32em;
        padding-left: 0;
    }
    li > * {
        max-width: 32em;
    }
    h2 + p {
        margin-top: 1em;
        font-size: 0.9em;
    }

    .heading {
        max-width: 40em;
        letter-spacing: -0.04em;
        font-size: 1.75em;
        line-height: 1.2;
        margin-top: 1.5em;
        text-wrap: balance;
        color: var(--brand-primary);
    }
    .heading:hover {
        color: var(--brand-primary-hover);
    }

    .description {
        font-size: 0.9em;
        margin-top: 0.8em;
    }

    @media (min-width: 43em) {
        h1 {
            font-size: 4.2em;
        }
        .heading {
            font-size: 2.45em;
            margin-top: 1.2em;
        }

        li > p {
            font-size: inherit;
        }
    }
</style>
